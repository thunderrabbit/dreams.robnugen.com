<?xml version="1.0"?>
<ruleset name="dreams">
    <description>
        dreams style gate: PSR-12 over classes/, wwwroot/, prepend.php and
        Tests/, enforced on every commit by .githooks/pre-commit. Fix with
        phpcbf where it can. (templates/*.tpl.php are mixed HTML/PHP and out
        of scope.) The PSR12 excludes below are sniffs dreams does not
        satisfy yet AND phpcbf cannot fix; remove one once its code is
        cleaned up.
    </description>

    <file>classes</file>
    <file>wwwroot</file>
    <file>prepend.php</file>
    <file>Tests</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/Tests/_output/*</exclude-pattern>
    <exclude-pattern>*/Tests/Support/_generated/*</exclude-pattern>

    <rule ref="PSR12">
        <!-- Pending manual cleanup (phpcbf can't fix; counts 2026-11-07): -->
        <exclude name="Generic.Files.LineLength"/>            <!-- 13: long lines -->
        <exclude name="PSR1.Classes.ClassDeclaration"/>       <!-- 11: no namespace / several classes in EDatabaseExceptions.php -->
        <exclude name="PSR12.Classes.ClosingBrace"/>          <!-- 5: stray ; after } in EDatabaseExceptions.php -->
    </rule>

    <!-- prepend.php is the bootstrap every page includes: it sets up the
         request and also declares print_rob(). EDatabaseExceptions.php's
         stray semicolons count as statements; it drops off with them. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>*/prepend.php</exclude-pattern>
        <exclude-pattern>*/classes/Database/EDatabaseExceptions.php</exclude-pattern>
    </rule>

    <!-- Codeception calls _before() and _after() by those exact names. -->
    <rule ref="PSR2.Methods.MethodDeclaration.Underscore">
        <exclude-pattern>*/Tests/*</exclude-pattern>
    </rule>
</ruleset>
